{
  "manifest_version": 3,
  "name": "YouTube Subscriber Previewer",
  "version": "1.3.1",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
